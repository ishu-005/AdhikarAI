ENV=dev
PORT=8000
LOG_LEVEL=INFO

# ── Groq LLM ───────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant
GROQ_MODELS=llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b,qwen-qwq-32b,mixtral-8x7b-32768,llama-3.1-70b-versatile,llama-3.1-8b-instant
GROQ_TEMPERATURE=0.2

# ── Embeddings & reranking (cloud — no local model download) ───
EMBEDDING_DIMENSION=1024
RERANKER_ENABLED=true
# FIXED provider for BOTH ingest and query: cohere | jina | hashing.
# Changing this REQUIRES re-ingesting the corpus — providers use different
# vector spaces, so mixing them silently breaks retrieval.
EMBEDDING_PROVIDER=cohere

# Cohere — embeddings + reranker (free trial: dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Jina AI — alternative embeddings (free 1M tokens: jina.ai → API Keys).
# Used only if EMBEDDING_PROVIDER=jina (not a silent fallback).
JINA_API_KEY=
JINA_EMBED_MODEL=jina-embeddings-v3

# ── Hybrid retrieval tuning ────────────────────────────────────
TOP_K=5
RETRIEVE_MULTIPLIER=3
RERANK_TOP_N=5
HYBRID_ENABLED=true
VECTOR_WEIGHT=0.6
FULLTEXT_WEIGHT=0.4

# ── Limits / CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=*
ALLOWED_UPLOAD_DOMAINS=criminal_law,consumer,labour,rti,human_rights,citizen_rights,women_family,property_finance,case_law,legislation,grievance
MAX_QUERY_CHARS=4000
UPLOAD_MAX_MB=20
CACHE_TTL_SECONDS=1800

# ── Ingestion ──────────────────────────────────────────────────
CRAWL_INTERVAL_HOURS=24
ALLOW_INSECURE_SSL=false

# ── Supabase (required for vector store + chat persistence) ────
USE_SUPABASE=true
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_API_KEY=your_service_role_key_here
SUPABASE_BUCKET_NAME=pdfs
